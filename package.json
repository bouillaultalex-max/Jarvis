{
  "name": "jarvis",
  "version": "0.1.0",
  "private": true,
  "description": "JARVIS — Personal AI desktop assistant",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "npm run dev --workspaces",
    "build": "npm run build --workspaces",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:tool-interface-bench": "tsc --noEmit -p prototypes/tool-interface-bench/tsconfig.json",
    "test": "vitest run",
    "bench:tool-interface:live": "tsx prototypes/tool-interface-bench/run-live.ts",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.0.0"
  }
}
