# Secrets/credentials qui ne doivent jamais être commités (préventif : M8
# introduit des credentials OAuth Gmail réels dans les prochains jalons).
*.pem
*.key
credentials.json
token.json
client_secret*.json
oauth*.json
secrets.*

*.log
.DS_Store
.vscode/

# Ruflo local secrets and runtime data
.env.local
.env.*.local
.claude-flow/data/
.claude-flow/logs/
.claude-flow/sessions/
.claude-flow/neural/
.claude-flow/metrics/

# Ruflo / AgentDB / RuVector — local databases (never commit)
.swarm/
ruvector.db
*.db
*.db-shm
*.db-wal

# Ruflo — machine-specific paths and mutable runtime state (regenerated locally)
